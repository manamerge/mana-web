{
    "name": "mana-web",
    "version": "0.1.0",
    "private": true,
    "scripts": {
        "build": "react-scripts build",
        "eject": "react-scripts eject",
        "format": "yarn run sort-package-json && yarn run prettier:fix && yarn run lint:fix",
        "postinstall": "husky",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "prepare": "husky",
        "prettier": "prettier . --check",
        "prettier:fix": "prettier . --write",
        "start": "react-scripts start",
        "test": "react-scripts test"
    },
    "lint-staged": {
        "**/*": "prettier --write --ignore-unknown"
    },
    "browserslist": {
        "production": [
            ">0.2%",
            "not dead",
            "not op_mini all"
        ],
        "development": [
            "last 1 chrome version",
            "last 1 firefox version",
            "last 1 safari version"
        ]
    },
    "dependencies": {
        "@manamerge/mana-atomic-ui": "1.0.215",
        "@testing-library/jest-dom": "^5.14.1",
        "@testing-library/react": "^13.0.0",
        "@testing-library/user-event": "^13.2.1",
        "@types/jest": "^27.0.1",
        "@types/node": "^16.7.13",
        "@types/react": "^18.0.0",
        "@types/react-dom": "^18.0.0",
        "leaflet": "^1.9.4",
        "react": "^18.3.1",
        "react-dom": "^18.3.1",
        "react-leaflet": "^4.2.1",
        "react-router-dom": "^7.0.1",
        "react-scripts": "5.0.1",
        "styled-components": "^6.1.19",
        "typescript": "^4.4.2",
        "web-vitals": "^2.1.0"
    },
    "devDependencies": {
        "@eslint/js": "^9.15.0",
        "@types/leaflet": "^1.9.21",
        "eslint": "^9.15.0",
        "eslint-config-prettier": "^9.1.0",
        "eslint-plugin-react": "^7.37.2",
        "globals": "^15.12.0",
        "husky": "^9.1.7",
        "lint-staged": "^15.2.10",
        "prettier": "^3.4.1",
        "sort-package-json": "^2.12.0",
        "typescript-eslint": "^8.16.0"
    }
}
